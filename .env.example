# Copy this file to .env and fill in real values before deploying.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# 0 in production, 1 for local development.
DJANGO_DEBUG=0

# Comma-separated hostnames allowed to serve the app. No spaces.
DJANGO_ALLOWED_HOSTS=your-app.vercel.app,localhost,127.0.0.1

# Proof-of-work leading zeros per block. 4 suits a demo; higher is slower to mine.
HONEYCHAIN_DIFFICULTY=4

# Leave empty to use the bundled SQLite file (fine for a demo; writes on Vercel
# are lost on cold start). Set it to a Postgres URL for persistent hosting, e.g.
# from Neon or Supabase, then run migrate and seed against it once:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
